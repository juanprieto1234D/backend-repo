# Copia este archivo como `.env` y completa los valores.
# `.env` está en .gitignore: nunca lo subas al repositorio.

# Base de datos (PostgreSQL en Docker, puerto 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/taskup_db?schema=public"

# URL del frontend, para el enlace de recuperación de contraseña.
# Expo web corre por defecto en 8081.
FRONTEND_URL=http://localhost:8081

# SMTP para el envío de correos.
# Sin estas variables, el enlace de recuperación se imprime en la consola
# del backend (modo desarrollo) y el flujo sigue funcionando.
#
# Gmail: activa la verificación en 2 pasos y crea una "Contraseña de aplicación".
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx
# CORREO_FROM=tucorreo@gmail.com
#
# Brevo (alternativa, 300 correos/día):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587

# Admin inicial: si se definen, al arrancar se crea la cuenta ADMIN
# (solo si no existe todavía).
# ADMIN_CORREO=admin@taskup.com
# ADMIN_CONTRASENA=Admin123*
# ADMIN_NOMBRE=Administrador TaskUp
